PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/aging-congress?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=Aging Congress
EMAIL_FROM=noreply@agingcongress.com

GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_PROJECT_ID=your-gcp-project-id
GCS_KEY_FILE=./service-account-key.json
